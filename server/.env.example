# Dev-only auth server — 환경변수 예시.
#
# ⚠️ 이 파일은 단순한 **문서**다. 서버 코드는 dotenv 같은 자동 로더를 쓰지 않는다.
# 실제 적용 방법은 둘 중 하나:
#
#   1) Node 20.6+ built-in `--env-file=.env` 사용 (M3-1f에서 추가)
#         cp .env.example .env
#         npm run start:env       # node --env-file=.env dist/index.js
#
#   2) shell env로 직접 전달
#         TICKSIDIAN_AUTH_PORT=8788 npm start
#         export TICKSIDIAN_AUTH_HOST=127.0.0.1 && npm start
#
# 절대 실제 secret을 이 파일에 적지 말 것. 예시 값만 둔다.
# `.env`/`.env.local` 둘 다 .gitignore에 잡혀 있다.

# ─── 네트워크 ──────────────────────────────────────────────
# 바인딩 (loopback only — dev에서만 쓴다)
TICKSIDIAN_AUTH_HOST=127.0.0.1
TICKSIDIAN_AUTH_PORT=8787

# CORS 허용 origin.
#
# ⚠️ 기본값은 **빈 값**(자동 허용 origin 0개). dev 서버라도 origin이 명시되지 않으면
# 어떤 cross-origin 요청에도 CORS 헤더를 돌려주지 않는다 (TICK-P0-004 보안 표면 좁히기).
#
# Tauri 데스크톱 앱이나 브라우저 dev 환경에서 호출하려면 사용자가 의도적으로
# 아래 한 줄을 활성화한다. smoke-test는 same-origin(loopback)이라 영향 없다.
#
#   TICKSIDIAN_AUTH_CORS_ORIGINS=http://localhost:5173,tauri://localhost
#
# 콤마로 여러 개 지정 가능.
TICKSIDIAN_AUTH_CORS_ORIGINS=

# ─── 영속화 (M3-1f) ────────────────────────────────────────
# SQLite DB 파일 경로. 빈 값 또는 미지정이면 ./data/auth.db.
# ":memory:"를 주면 휘발 store(테스트/CI 용).
TICKSIDIAN_AUTH_DB_PATH=./data/auth.db
