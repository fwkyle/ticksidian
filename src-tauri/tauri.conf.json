{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ticksidian-desktop",
  "version": "0.1.0",
  "identifier": "com.ticksidian.desktop",
  "build": {
    "beforeDevCommand": "cd app && npm run dev",
    "beforeBuildCommand": "cd app && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ticksidian-desktop",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:5173",
        "script-src": "'self' http://localhost:5173",
        "style-src": "'self' 'unsafe-inline' http://localhost:5173",
        "img-src": "'self' data: blob: https: http://localhost:5173",
        "font-src": "'self' data: http://localhost:5173",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* http://localhost:5173 ws://localhost:5173"
      },
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}