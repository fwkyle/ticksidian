    "@blocknote/react": "^0.47.3",
    "@excalidraw/excalidraw": "^0.18.1",
    "@hocuspocus/provider": "^3.4.4",
    "@mantine/core": "^8.3.18",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "js-yaml": "^4.1.1",
    "react": "^18.3.1",
