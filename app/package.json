    "qa:error-utils": "node --experimental-strip-types qa-error-utils.mjs",
    "qa:folder-tree": "node --experimental-strip-types qa-folder-tree.mjs",
    "qa:note-list-view": "node --experimental-strip-types qa-note-list-view.mjs && node --experimental-strip-types --test qa-local-record-search.mjs",
    "qa:note-size": "node --experimental-strip-types qa-note-size.mjs",
