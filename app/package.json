    "qa:priority": "node --experimental-strip-types qa-priority.mjs",
    "qa:start-screen": "node --experimental-strip-types qa-start-screen.mjs",
    "qa": "npm run qa:note-recovery && npm run qa:editor-diagnostics && npm run qa:error-utils && npm run qa:dark-contrast && npm run qa:note-info && npm run qa:note-list-view && npm run qa:folder-tree && npm run qa:note-size && npm run qa:note-open-selection && npm run qa:external-change-summary && npm run qa:folder-ops && npm run qa:archive-folder && npm run qa:panel-layout && npm run qa:local-fs && npm run qa:note-editor && npm run qa:note-editor-flow && npm run qa:note-editor-preserve && npm run qa:note-editor-metadata && npm run qa:perf && npm run qa:vault-adapter && npm run qa:image-embeds && npm run qa:priority && npm run qa:editor-clipboard && npm run qa:excalidraw-document && npm run qa:auth-refresh && npm run qa:sync-queue && npm run qa:sync-replay && npm run qa:todos-migration && npm run qa:html-export && npm run qa:markdown-export && npm run qa:rag-conversion && npm run qa:review-queue && npm run qa:secrets-viewer && npm run qa:note-filename && npm run qa:note-editor-image-embeds && npm run qa:image-attachments && npm run qa:image-attachment-cleanup && npm run qa:start-screen",
